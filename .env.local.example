# Supabase : URL du projet et clé service_role (serveur uniquement, jamais exposée au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe : clé secrète et secret de signature du webhook /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend : envoi des e-mails transactionnels
RESEND_API_KEY=

# Secrets internes : chaînes aléatoires longues, une par usage
CRON_SECRET=
ARBITRATION_WEBHOOK_SECRET=
CALL_TOKEN_SECRET=

# URL publique de l'application, utilisée dans les liens des e-mails
NEXT_PUBLIC_APP_URL=http://localhost:3000
